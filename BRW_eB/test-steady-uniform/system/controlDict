FoamFile
{
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// application     rheoInterFoam;
application     incompressibleVoF;

startFrom       latestTime;

startTime       0;

stopAt          endTime;

endTime         2.80; 

deltaT          0.000001;

writeControl    adjustableRunTime;

writeInterval   0.2;

purgeWrite      0;

// writeFormat     ascii;
writeFormat     binary;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable yes;

adjustTimeStep  yes;

maxCo           0.48;

maxAlphaCo      0.48;

maxDeltaT       0.005;

libs (
    //    "libsimpleFunctionObjects.so"
        // "libsimpleSwakFunctionObjects.so"
        // "libswakFunctionObjects.so"
        // "libgroovyBC.so"
        // "libOpenFOAM.so"
        // "libforces.so"
);

