FoamFile
{
    format      ascii;
    class       dictionary;
    location    "constant";
    object      momentumTransport.air;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

simulationType  laminar;

// The physicalProperties.air viscosityModel is constant, so the laminar
// stress model is Newtonian without an additional laminar sub-dictionary.

// ************************************************************************* //
