FoamFile
{
    format      ascii;
    class       dictionary;
    location    "constant";
    object      physicalProperties.water;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Base phase properties.  For the Herschel-Bulkley model, nu is nu0,
// the low-strain-rate/capped kinematic viscosity.
viscosityModel  constant;

nu              0.0208;
rho             1202;

// ************************************************************************* //
